{
  "name": "financial-mfe-hub",
  "version": "0.0.0",
  "private": true,
  "packageManager": "pnpm@10.15.0",
  "engines": {
    "node": ">=22.0.0",
    "pnpm": ">=10.0.0"
  },
  "scripts": {
    "dev": "turbo run dev --parallel",
    "dev:stable": "turbo run dev dev:stable --parallel",
    "build": "turbo run build",
    "lint": "turbo run lint",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "format:check": "turbo run format:check",
    "tag": "node scripts/tag.mjs",
    "render:init": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 init",
    "render:validate": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 validate",
    "render:plan": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 plan",
    "render:apply": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 apply",
    "render:output": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 output",
    "render:destroy": "powershell -NoProfile -ExecutionPolicy Bypass -File infrastructure/terraform/environments/production/scripts/render.ps1 destroy"
  },
  "devDependencies": {
    "turbo": "^2.5.6"
  }
}
